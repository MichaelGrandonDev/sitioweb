# Credenciales FTP del hosting (cPanel → Cuentas FTP)
# Copiá este archivo a .env y completá los valores. .env nunca se sube al repo.

FTP_HOST=ftp.tudominio.com
FTP_USER=usuario@tudominio.com
FTP_PASS=
FTP_PORT=21

# Carpeta remota relativa al home de la cuenta FTP.
# Si la cuenta ya apunta al Document Root del dominio, dejá "/".
FTP_REMOTE_DIR=/

# 1 = FTPS (recomendado). Si falla la conexión, probá FTP_TLS=0
FTP_TLS=1

# Pacientes · puente con Cursor (tools/cursor_bridge). Solo en tu Mac, nunca en el servidor.
# CURSOR_API_KEY: Cursor Dashboard → Integrations → API key.
# PACIENTES_BRIDGE_TOKEN: Pacientes → Ajustes de IA → «Crear el token del puente».
CURSOR_API_KEY=
PACIENTES_BRIDGE_TOKEN=
# Opcionales:
# PACIENTES_BRIDGE_URL=https://fluxusterapia.com/turnos/pacientes_bridge.php
# MTC_LIBRARY_DIR=~/Desktop/material-mtc/_extraido
# CURSOR_MODEL=composer-2.5

# Deploy:
#   python3 deploy.py          → una vez
#   python3 watch_deploy.py    → cada vez que guardás cambios
