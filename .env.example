# Credenciales FTP del hosting (cPanel → Cuentas FTP)
# Copiá este archivo a .env y completá los valores. .env nunca se sube al repo.

FTP_HOST=ftp.tudominio.com
FTP_USER=usuario@tudominio.com
FTP_PASS=
FTP_PORT=21

# Carpeta remota relativa al home de la cuenta FTP.
# Si la cuenta ya apunta al Document Root del dominio, dejá "/".
FTP_REMOTE_DIR=/

# 1 = FTPS (recomendado). Si falla la conexión, probá FTP_TLS=0
FTP_TLS=1

# Deploy:
#   python3 deploy.py          → una vez
#   python3 watch_deploy.py    → cada vez que guardás cambios
