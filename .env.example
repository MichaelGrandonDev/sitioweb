# Credenciales FTP de HostGator (cPanel → Cuentas FTP)
# Copiá este archivo a .env y completá los valores.

FTP_HOST=ftp.mike88developer.com
FTP_USER=Fluxusterapia@fluxusterapia.com
FTP_PASS=tu_password_ftp
FTP_PORT=21

# Carpeta FTP de la cuenta Fluxusterapia (hoy es el home de mikedeve, NO el
# Document Root real de fluxusterapia.com). Para auto-deploy, en cPanel →
# Cuentas FTP → Cambiar directorio de esa cuenta a la ruta exacta que muestra
# Dominios → fluxusterapia.com → Document Root.
# Mientras tanto usá File Manager + zip, o dejá:
FTP_REMOTE_DIR=/

# 1 = FTPS (recomendado). Si falla la conexión, probá FTP_TLS=0
FTP_TLS=1

# Auto-deploy:
#   python3 deploy.py          → una vez
#   python3 watch_deploy.py    → cada vez que guardás cambios
# También hay un hook de Cursor (.cursor/hooks.json) que publica al terminar el agente.
