# Prefer HTML redirect first (HostGator sometimes ignores PHP DirectoryIndex alone)
DirectoryIndex index.html index.php login.php
Options -Indexes

<FilesMatch "^(config|bootstrap)\.php$|^error_log$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /academia/ or /academia → index.php
  RewriteRule ^$ index.php [L]
</IfModule>
